# ── NVIDIA NIM (AI explanations) ──
# Optional server-side fallback. The primary flow stores the NVIDIA API key
# in the user's browser via the in-app Settings dialog (no env var needed).
# Set this only for headless self-hosting where you want a shared key for
# every visitor. Free keys: https://build.nvidia.com/
NVIDIA_API_KEY=

# ── Reading Club (opt-in; leave ALL of these unset for the default app) ──
# When unset, the app is byte-for-byte today's: no club UI ships, the
# /api/club proxy 404s, and nothing ever leaves the browser.
#
# Frontend (Vercel):
#   NEXT_PUBLIC_CLUB_ENABLED  build-time flag; 'true' includes the club UI in
#                             the client bundle (dynamic-imported). Leave unset
#                             on the public demo so club code never ships.
#   NEXT_PUBLIC_CLUB_API_URL  browser-visible API base. Local development uses
#                             http://localhost:8080; production uses the Oracle
#                             HTTPS gateway (never place a secret in this var).
#   CLUB_ENABLED              server flag; 'true' lets the /api/club proxy route
#                             forward to the backend (otherwise it 404s).
#   CLUB_BACKEND_URL          base URL of the Oracle backend the proxy forwards
#                             to, e.g. http://134.185.90.180:8080  (switch to
#                             https:// once the box has a TLS cert).
#   CLUB_PROXY_SECRET         shared secret sent as x-club-proxy-secret so the
#                             open backend port only accepts calls from Vercel.
NEXT_PUBLIC_CLUB_ENABLED=
NEXT_PUBLIC_CLUB_API_URL=http://localhost:8080
CLUB_ENABLED=
CLUB_BACKEND_URL=
CLUB_PROXY_SECRET=

# Backend (Oracle box only — NOT set on Vercel). See docs/self-host-oracle.md:
#   DATABASE_URL, CLUB_JWT_SECRET, CLUB_BLOB_DIR, CLUB_PROXY_SECRET,
#   CLUB_NAME, PORT, SYNC_MAX_BYTES (first owner joins via a bootstrap invite
#   printed to the backend logs; owners then mint per-member single-use invites)
