# ReadAura club backend (Oracle box only — NOT set on Vercel).
# Copy to .env and fill in. See ../docs/self-host-oracle.md.

# Postgres (local to the box)
DATABASE_URL=postgresql://readaura:CHANGE_ME@localhost:5432/readaura_club

# HS256 secret for member/recovery JWTs (generate: openssl rand -base64 48)
CLUB_JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://readaura-ai.vercel.app,https://readaura-eight.vercel.app,https://readaura-mananbordias-projects.vercel.app,https://readaura-mananbordia-mananbordias-projects.vercel.app

# Loopback-only port used by local Nginx. Do not open it publicly.
PORT=8080

# Single-club seed (created on first start if no club exists yet). The first
# owner joins via a single-use BOOTSTRAP OWNER INVITE printed to the logs on
# first start (journalctl -u readaura-club); owners then mint per-member invites
# from the in-app Club panel. There is no shared invite code.
CLUB_NAME=ReadAura Club

# Max bytes accepted per personal-sync item.
SYNC_MAX_BYTES=5000000
