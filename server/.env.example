# ReadAura club backend (Oracle box only — NOT set on Vercel).
# Copy to .env and fill in. See ../docs/self-host-oracle.md.

# Postgres (local to the box)
DATABASE_URL=postgresql://readaura:CHANGE_ME@localhost:5432/readaura_club

# HS256 secret for member/recovery JWTs (generate: openssl rand -base64 48)
CLUB_JWT_SECRET=

# Shared secret the Vercel proxy sends as x-club-proxy-secret. MUST match the
# CLUB_PROXY_SECRET set on Vercel, so the open backend port only accepts the proxy.
CLUB_PROXY_SECRET=

# Port the Hono server listens on (open this in the Oracle Security List).
PORT=8080

# Single-club seed (created on first start if no club exists yet).
CLUB_NAME=ReadAura Club
CLUB_INVITE_CODE=

# Max bytes accepted per personal-sync item.
SYNC_MAX_BYTES=5000000
